############################################################################
### RevBayes: Relaxed state-dependent multivariate brownian motion model ###
############################################################################
# Following the online tutorial available here: https://revbayes.github.io/tutorials/cont_traits/state_dependent_bm.html

# Also referred to as MuSSCRat (Multiple State-Specific Rates of continuous-character evolution), and this approach is originally described in:
# May M., Moore B.R. 2020 A Bayesian approach for inferring the impact of a discrete character on rates of continuous-character evolution in the presence of background-rate variation. Syst Biol 69, 530-544. (doi:10.1093/sysbio/syz069).



#######################
# Reading in the Data #
#######################

DATASET = "DATASET"

# Read in the tree - 105spp of Poa
T <- readTrees("treefile.nex")[1]
ntips <- T.ntips()
nbranches <- 2 * ntips - 2

# Read in the continuous character data - this is the multivariate response variable, this is niche breadth variables or niche centroids
cont <- readContinuousCharacterData("continuouscharacterdata.nex")
nchar <- cont.nchar()

# Read in the discrete character data - in this case this is whether species have endophyte or not
disc <- readDiscreteCharacterData("discretechracterdata.nex")
num_disc_states <- disc.getStateDescriptions().size()

# Setting up the RevBayes analysis
# initialize a variable for our vector of moves and monitors:
moves    = VectorMoves()
monitors = VectorMonitors()



########################
# Specifying the model #
########################

# this model is a bit complicated so there are many different parts to it, we have:
#       - the tree
#       - discrete character model
#       - continuous character model (relaxed to account for background rates of variation)
#       - mutivarate model (since we are using a multivariate response)
#       - the overall brownian motion model 

# First, we create a constant node for the tree that corresponds to the observed phylogeny.

##################
### Tree model ###
##################

tree <- T

###############################
### Discete-character model ###
###############################

# make the Q matrix
Q <- fnJC(num_disc_states)

# make the transition rate parameter
lambda ~ dnLoguniform(1e-3, 1) 
moves.append( mvScale(lambda, weight=1.0) )


# Now, we draw the discrete character data and its character history from a CTMC model
X ~ dnPhyloCTMCDASiteIID(tree, Q, branchRates=lambda, type="Standard", nSites=1)
X.clamp(disc) 

# include proposals for the discrete character history
moves.append( mvCharacterHistory(ctmc=X, qmap_site=Q, graph="node",   proposal="rejection", weight=20.0) )
moves.append( mvCharacterHistory(ctmc=X, qmap_site=Q, graph="branch", proposal="rejection", weight=20.0) )

# keep track of the number of discrete-character transitions along each branch, and over the whole phylogeny

for(i in 1:nbranches) {
    num_changes[i] := sum(X.numCharacterChanges(i))
}
total_num_changes := sum(num_changes)


#############################################################################################################
### Specify the correlation matrix and build the variance-covariance matrix for the continuous characters ###
#############################################################################################################


# To use multivariate data, we must also specify a prior model for the variance-covariance matrix, Σ
# More info on this can be found here: https://revbayes.github.io/tutorials/cont_traits/multivariate_bm.html

# First, we specify the relative rates of change among the continuous characters.

alpha <- 1.0
proportional_rates ~ dnDirichlet( rep(alpha, nchar) )
relative_rates := proportional_rates * nchar
moves.append( mvBetaSimplex(proportional_rates, weight=2.0) )

# Next, we specify an LKJ prior on the partial correlation matrix, P, and transform it into a full correlation matrix, R.

eta <- 1.0
P ~ dnLKJPartial( eta, nchar )

moves.append( mvCorrelationMatrixRandomWalk(P, weight=3.0) )
moves.append( mvCorrelationMatrixSingleElementBeta(P, weight=5.0) )

R := fnPartialToCorr(P)

correlations := R.upperTriangle()

# construct the variance-covariance matrix, Σ, from the relative rates for each character and the correlation matrix.

V := fnDecompVarCovar( relative_rates^0.5, R )



##################################
### Continuous-character model ###
##################################

# here I am using the model that relaxes the background rate rather than assuming a constant rate. This is described under "Controlling for Background-Rate Variation" and "Relaxing the background-rate of evolution" in the tutorial (https://revbayes.github.io/tutorials/cont_traits/state_dependent_bm.html)

# specify the background rate at the root of the tree
beta_root ~ dnLoguniform(1e-3, 1)
moves.append( mvScale(beta_root, weight=1.0) )

# specify the prior on the expected number of rate shifts.
expected_number_of_shifts <- 10 # this is user specified and needs to be changed to test influence, I repeated these models testing 5,10, and 15 rate shifts
rate_shift_probability    <- expected_number_of_shifts / nbranches

# specify the prior on the magnitude of rate shifts
sd = 0.587
rate_shift_distribution = dnLognormal(-sd^2/2, sd)

# specify the branch-specific rates
for(i in nbranches:1) {

    # draw the rate multiplier from a mixture distribution
    branch_rate_multiplier[i] ~ dnReversibleJumpMixture(1, rate_shift_distribution, Probability(1 - rate_shift_probability) )

    # compute the rate for the branch
    if ( tree.isRoot( tree.parent(i) ) ) {
       background_rates[i] := beta_root * branch_rate_multiplier[i]
    } else {
       background_rates[i] := background_rates[tree.parent(i)] * branch_rate_multiplier[i]
    }

    # keep track of whether the branch has a rate shift
    branch_rate_shift[i] := ifelse( branch_rate_multiplier[i] == 1, 0, 1 )

    # use reversible-jump to move between models with and without
    # shifts on the branch
    moves.append( mvRJSwitch(branch_rate_multiplier[i], weight=1) )

    # include proposals on the rate mutliplier (when it is not 1)
    moves.append( mvScale(branch_rate_multiplier[i], weight=1) )

}

# keep track of the number of rate shifts
num_rate_changes := sum( branch_rate_shift )


######################################################################
#### specify the relative state-dependent rates (with sum 1) -  model selection using Reversible-Jump MCMC

#To test the hypothesis that rates depend on the discrete state, we imagine two models. The first model, where states do not depend on the discrete character, i.e., when all of the discrete characters confer the same rate of discrete character evolution (set to 1). The second model corresponds to the state-dependent model described previously.

#To enable rjMCMC, we simply have to place a reversible-jump prior on the relevant parameter. We can modify the prior on proportional_zeta so that it takes either a constant value where all rates are equal (simplex(rep(1, num_disc_states))), or is drawn from a Dirichlet prior distribution, dnDirichlet( rep(concentration, num_disc_states) ). We specify a prior probability on the state-independent model of p = 0.5.

concentration <- 1.0
proportional_zeta ~ dnReversibleJumpMixture( simplex(rep(1,num_disc_states)), dnDirichlet( rep(concentration, num_disc_states) ), p=0.5 )

moves.append( mvRJSwitch(proportional_zeta, weight=10.0) )
moves.append( mvBetaSimplex(proportional_zeta, weight=1.0) )

is_state_dependent := ifelse( proportional_zeta == simplex(rep(1,num_disc_states)), 0.0, 1.0)

######################################################################


# compute the state dependent rates (with mean 1)
zeta := proportional_zeta * num_disc_states

# compute the state-dependent branch rates
for(i in 1:nbranches) {
    state_branch_rate[i] := sum(X.relativeTimeInStates(i,1) * zeta)
}

# compute the overall branch rates (including the background rates)
branch_rates := state_branch_rate * background_rates



#############################
### Brownian-motion model ###
#############################

# Now that we have specified the branch-specific rate parameters, we can draw the character data from the corresponding phylogenetic Brownian-motion model - we are performing a multivariate analysis, so we use dnPhyloMultivariateBrownianREML and provide V (Σ) as an additional argument.

Y ~ dnPhyloMultivariateBrownianREML(tree, branchRates=branch_rates^0.5, rateMatrix=V) 
Y.clamp(cont)


# Finally, we create a workspace object for the entire model with model().

mymodel = model(zeta)


#################################
### Running the MCMC analysis ###
#################################

# Specifying Monitors to output parameter values to file and screen

monitors.append( mnModel(filename="output/MuSSCRat_"+DATASET+".log", printgen=10) )
monitors.append( mnScreen(printgen=1000, zeta, num_rate_changes, total_num_changes) )

# for part of relaxing the background rates we also include an extended Newick monitor to keep track of the three different kinds of branch-specific rates.
monitors.append( mnExtNewick(filename="output/MuSSCRat_"+DATASET+".trees", isNodeParameter=TRUE, printgen=10, separator=TAB, tree=tree, state_branch_rate, background_rates, branch_rates) )


# Initializing and Running the MCMC Simulation
mymcmc = mcmc(mymodel, monitors, moves, nruns=1, combine="mixed")

mymcmc.burnin(generations=50000, tuningInterval=100)
mymcmc.run(generations=500000)

# for part of relaxing the background rates we summarize the branch-specific rates after we run the MCMC analysis.

treetrace = readTreeTrace("output/MuSSCRat_"+DATASET+".trees")
map_tree = mapTree(treetrace,"output/MuSSCRat_"+DATASET+"_MAP.tre")


# quit once everything has finished running
q()